# === Wajib di produksi ===
ADMIN_PASSWORD=ganti-dengan-password-kuat   # password masuk dashboard
SESSION_SECRET=string-acak-panjang          # bebas, untuk tanda tangan sesi
APP_URL=https://social.marqthink.com        # URL dashboard (tanpa / di akhir)

# === AI (Claude) — tanpa ini aplikasi jalan di mode demo ===
ANTHROPIC_API_KEY=

# === Database & penyimpanan gambar (Supabase) — tanpa ini data disimpan lokal di .data/ ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === Auto-posting ke Instagram & TikTok (Ayrshare) — tanpa ini desain hanya bisa diunduh ===
AYRSHARE_API_KEY=
