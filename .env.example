# === Wajib di produksi ===
SESSION_SECRET=string-acak-panjang          # wajib: kunci tanda tangan sesi login
APP_URL=https://social.domainkamu.com       # URL aplikasi (tanpa / di akhir)
SUPPORT_EMAIL=                              # opsional: email bantuan (tampil di halaman Lupa password)

# === Login dengan Google (opsional) — redirect URI: <APP_URL>/api/auth/google/callback ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AI copy & art director (Claude) — tanpa ini aplikasi jalan di mode demo ===
ANTHROPIC_API_KEY=

# === Database & penyimpanan gambar (Supabase) — tanpa ini data disimpan lokal di .data/ ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === Gambar (opsional, pilih minimal satu untuk foto otomatis) ===
# AI image generation — isi salah satu:
GEMINI_API_KEY=            # Google AI Studio (model default: gemini-2.5-flash-image)
OPENAI_API_KEY=            # OpenAI (model default: gpt-image-1)
# Rekomendasi: GEMINI_API_KEY — gambar referensi desain dikirim sebagai contoh gaya foto.
# IMAGE_PROVIDER=gemini    # paksa provider bila dua-duanya diisi
# GEMINI_IMAGE_MODEL=      # override nama model
# OPENAI_IMAGE_MODEL=
# Stok foto gratis (cadangan bila AI image gagal / mode "stok"):
PEXELS_API_KEY=

# === Auto-posting ke Instagram & TikTok (Ayrshare) — tanpa ini desain hanya bisa diunduh ===
AYRSHARE_API_KEY=

# === Performa (menu Performa: baca likes/komentar dari link) ===
# TikTok terbaca gratis tanpa kunci. Instagram butuh konektor Apify (ada kredit gratis bulanan).
APIFY_TOKEN=
# Rahasia untuk pembaruan harian otomatis (Vercel Cron mengirimnya sebagai Bearer token).
CRON_SECRET=
